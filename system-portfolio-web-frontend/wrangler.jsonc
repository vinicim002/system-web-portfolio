{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Front do portfólio no Cloudflare Workers via @opennextjs/cloudflare
  "name": "system-portfolio-web",
  // worker.ts envolve o worker gerado pelo OpenNext e adiciona o cron de keep-alive
  "main": "worker.ts",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Cache do Next (open-next.config.ts); namespace "system-portfolio-web-cache"
  "kv_namespaces": [{ "binding": "NEXT_INC_CACHE_KV", "id": "0d3aa9c37f8b4586b43bae65763474c5" }],
  // Marcas de invalidação do cache (revalidateTag ao salvar no admin); banco "system-portfolio-web-tag-cache"
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "system-portfolio-web-tag-cache",
      "database_id": "4bc707d1-ad2f-41d7-adf3-f7c438446171"
    }
  ],
  // Otimização do next/image (Cloudflare Images; plano grátis com limite mensal)
  "images": {
    "binding": "IMAGES"
  },
  // Domínio próprio; www redireciona para o domínio sem www (src/proxy.ts)
  "routes": [
    { "pattern": "viniciusvilanova.com", "custom_domain": true },
    { "pattern": "www.viniciusvilanova.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  // Keep-alive do Supabase (plano grátis pausa após 7 dias sem uso): segunda e quinta, 12h UTC
  "triggers": {
    "crons": ["0 12 * * 1,4"]
  },
  "observability": {
    "enabled": true
  },
  // Admin liberado em produção (spec 002, História 5): login real com segundo fator (TOTP)
  "vars": {
    "ADMIN_ENABLED": "true"
  },
  // Sem telemetria do wrangler
  "send_metrics": false
  // Secrets (fora do git, via `npx wrangler secret put <NOME>`):
  //   SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY → usados pelo cron de keep-alive
}
